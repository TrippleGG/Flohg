servers:
  - url: [api.flohg.local](https://api.flohg.local)
paths:
  /auth/otp/start:
    post:
      summary: Start OTP login
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties: phone:
                type: string
      responses:
        '200': { description: OTP sent }
  /auth/otp/verify:
    post:
      summary: Verify OTP
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                phone: { type: string }
                code: { type: string }
      responses:
        '200':
          description: Authenticated
          content:
            application/json:
              schema:
                type: object
                properties:
                  accessToken: { type: string }
                  refreshToken: { type: string }
  /tasks:
    get:
      summary: Search posted tasks nearby
      parameters:
        - in: query; name: lat; schema: { type: number }
        - in: query; name: lng; schema: { type: number }
        - in: query; name: radiusKm; schema: { type: number, default: 10 }
        - in: query; name: categoryId; schema: { type: string }
        - in: query; name: subcategoryId; schema: { type: string }
        - in: query; name: status; schema: { type: string, enum: [posted] }
        - in: query; name: requiresVerified; schema: { type: string, enum: [driver_license, degree] }
      responses:
        '200':
          description: Tasks
          content:
            application/json:
              schema:
                type: array
                items: { $ref: '#/components/schemas/Task' }
    post:
      summary: Create a task
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/CreateTask' }
      responses:
        '201': { description: Created }
  /tasks/{id}:
    get:
      summary: Get task detail
      parameters: [{ in: path, name: id, required: true, schema: { type: string } }]
      responses:
        '200':
          content:
            application/json:
              schema: { $ref: '#/components/schemas/Task' }
  /tasks/{id}/offers:
    post:
      summary: Create offer on a task (guarded by verification where applicable)
      parameters: [{ in: path, name: id, required: true, schema: { type: string } }]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                amount: { type: integer, description: NGN }
                message: { type: string }
                etaMinutes: { type: integer }
      responses:
        '201': { description: Offer created }
  /offers/{id}:
    patch:
      summary: Counter/withdraw/accept
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                action: { type: string, enum: [counter, withdraw, accept] }
                amount: { type: integer }
      responses:
        '200': { description: Updated }
  /offers/{id}/accept:
    post:
      summary: Accept offer → Agreement + escrow init
      responses:
        '201':
          content:
            application/json:
              schema: { $ref: '#/components/schemas/Agreement' }
  /agreements/{id}/escrow/hold:
    post:
      summary: Idempotent escrow hold (card auth or virtual account)
      responses: { '200': { description: OK } }
  /agreements/{id}/release:
    post:
      summary: Release escrow on completion
      responses: { '200': { description: Released } }
  /agreements/{id}/refund:
    post:
      summary: Refund after dispute resolution
      responses: { '200': { description: Refunded } }
  /payments/webhook/paystack:
    post:
      summary: Paystack webhook
      responses: { '200': { description: OK } }
  /verifications/status:
    get:
      summary: Current user verification statuses
      responses:
        '200':
          content:
            application/json:
              schema: { $ref: '#/components/schemas/VerificationStatus' }
  /verifications/driver-license:
    post:
      summary: Submit driver license for verification (Taxi categories)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                number: { type: string }
                expiry: { type: string, format: date }
                docUrl: { type: string }
                selfieUrl: { type: string }
      responses: { '202': { description: Pending review } }
  /verifications/degree:
    post:
      summary: Submit degree proof (Tutoring)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                level: { type: string }
                institution: { type: string }
                docUrl: { type: string }
      responses: { '202': { description: Pending review } }
  /verifications/referee/confirm:
    post:
      summary: Public endpoint hit by SMS form
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                token: { type: string }
                score: { type: integer, minimum: 1, maximum: 5 }
                comment: { type: string }
      responses: { '200': { description: Stored } }
  /pricing/suggest:
    get:
      summary: Price suggestion by category and attributes
      parameters:
        - in: query; name: categoryId; schema: { type: string }
        - in: query; name: subcategoryId; schema: { type: string }
        - in: query; name: attrs; schema: { type: string, description: JSON-encoded }
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                properties:
                  min: { type: integer }
                  median: { type: integer }
                  max: { type: integer }
                  rationale: { type: string }
components:
  schemas:
    Task:
      type: object
      properties:
        id: { type: string }
        requesterId: { type: string }
        categoryId: { type: string }
        subcategoryId: { type: string, nullable: true }
        title: { type: string }
        description: { type: string }
        attributes: { type: object, additionalProperties: true }
        photos:
          type: array
          items: { type: string }
        lat: { type: number }
        lng: { type: number }
        addressText: { type: string }
        landmark: { type: string, nullable: true }
        lga: { type: string, nullable: true }
        scheduledAt: { type: string, format: date-time, nullable: true }
        budgetProposed: { type: integer }
        priceType: { type: string, enum: [fixed, negotiable] }
        status: { type: string, enum: [posted, accepted, in_progress, submitted, completed, cancelled] }
    CreateTask:
      allOf:
        - $ref: '#/components/schemas/Task'
      required: [categoryId, title, description, attributes, lat, lng, addressText, budgetProposed, priceType]
    Agreement:
      type: object
      properties:
        id: { type: string }
        taskId: { type: string }
        taskerId: { type: string }
        agreedAmount: { type: integer }
        acceptedAt: { type: string, format: date-time }
        escrow:
          type: object
          properties:
            type: { type: string, enum: [card_auth, virtual_account] }
            provider: { type: string, enum: [paystack] }
            status: { type: string, enum: [pending, held, released, refunded, failed] }
            vaBank: { type: string, nullable: true }
            vaAccount: { type: string, nullable: true }
            expiresAt: { type: string, format: date-time, nullable: true }
    VerificationStatus:
      type: object
      properties:
        nextOfKin: { type: boolean }
        referee: { type: boolean }
        driverLicense: { type: string, enum: [missing, pending, approved, rejected] }
        degree: { type: string, enum: [missing, pending, approved, rejected] }
## Architecture Overview

- Mobile (Flutter) consumes REST + WebSocket (future) from API.
- API (NestJS) modules:
  - Auth (OTP via Termii)
  - Users (profiles, KYC tiers, next-of-kin, referee)
  - Verifications (driver license, degree, referee confirm)
  - Tasks (JSONB attributes, PostGIS search)
  - Offers (negotiation, counters)
  - Agreements (accept → escrow)
  - Payments (Paystack: card auth or virtual account; webhook handling)
  - Pricing (heuristic price suggestions)
  - Admin (verification queue, disputes, payments events)
- Data: Postgres + PostGIS; Redis for queues and caching.
- Media: S3-compatible (configure later).

Trust gates:
- Taxi: driver license approved
- Tutoring: degree approved
- Withdrawals: next of kin + referee required
## Ops Runbook (Pilot)

- OTP: Termii; rate limit per phone/IP.
- Escrow: Card auth preferred; Virtual Account with 30–60 min expiry.
- Auto-release: 48h after submission absent dispute.
- Disputes: freeze release, collect evidence, resolve in admin.
- Verifications: queue targets <24h turnaround.
- Metrics to watch: time-to-first-offer, completion rate, dispute rate, payout latency.
